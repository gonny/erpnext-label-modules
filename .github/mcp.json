{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/workspace"
      ]
    },
    "shell": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-shell"],
      "env": {
        "ALLOWED_COMMANDS": "bench,pytest,ruff,mypy,pre-commit,pip,pip-audit,curl,cat,ls,find,grep,echo,pwd,cd"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "frappe-mcp": {
      "command": "python",
      "args": ["-m", "frappe_mcp"],
      "env": {
        "FRAPPE_URL": "http://development.localhost:8000",
        "FRAPPE_API_KEY": "${FRAPPE_API_KEY}",
        "FRAPPE_API_SECRET": "${FRAPPE_API_SECRET}"
      }
    }
  }
}

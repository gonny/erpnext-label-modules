# ─── Frappe versions ────────────────────────────────────────────────────────
FRAPPE_BRANCH=version-16
ERPNEXT_BRANCH=version-16

# ─── Database ────────────────────────────────────────────────────────────────
# MariaDB root password used during bench site creation
MARIADB_ROOT_PASSWORD=123

# ─── Runtime requirements (informational — enforced in Dockerfile/image) ────
# Python >= 3.11
# Node >= 20
# MariaDB >= 10.8

# ─── Site ────────────────────────────────────────────────────────────────────
SITE_NAME=development.localhost
SITE_ADMIN_PASSWORD=admin
